# Copy this file to .env and fill in real values. Never commit .env.

# Required by ENGINE01 (intent extraction), ENGINE02 (recommendation reasons),
# ENGINE03 (feedback structuring), and the generation module (image_generation tool).
# See CLAUDE.md "P0 action item" if this is not set up yet.
OPENAI_API_KEY=

# Optional: override the default model per module during development.
OPENAI_MODEL=gpt-4o-mini

# Pinterest API v5 (Trial access, team account) — used by backend/pinterest only.
PINTEREST_ACCESS_TOKEN=
