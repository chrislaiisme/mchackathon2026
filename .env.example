# Copy this file to .env and fill in real values. Never commit .env.

# ENGINE01 does NOT need this -- it runs on `codex exec` (your ChatGPT Plus/Pro
# subscription via `codex login`, no API key). See CLAUDE.md "ENGINE01 執行方式：
# codex exec". This is still needed by ENGINE02 (recommendation reasons), ENGINE03
# (feedback structuring), and the generation module (image_generation tool), if/when
# the team decides to get a platform.openai.com key -- see CLAUDE.md "P0 現況".
OPENAI_API_KEY=

# Optional: override the default model per module during development.
OPENAI_MODEL=gpt-4o-mini

# Local Whisper speech-to-text. These are the defaults; uncomment to override.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# 鎖定語言。留空 = 自動偵測；使用者只講一句短的中文需求時 auto 有機會判成
# 日文或其他語言，demo 建議直接鎖 zh，順便省掉偵測那一步。
# WHISPER_LANGUAGE=zh
# WHISPER_API_URL=http://127.0.0.1:9000/transcribe

# Optional ENGINE01 tuning (defaults are fine) -- see backend/engine01_intent/llm_client.py
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=low
# CODEX_TIMEOUT_SECONDS=90

# Pinterest API v5 (Trial access, team account) — used by backend/pinterest only.
# 2026-09-19 起也被 ENGINE01 的 /intent 用來做單輪參考圖 fallback（使用者沒上傳圖
# 時，比對這個 board 找一張相關圖，只供 ENGINE02 內部參考，不會顯示在畫面上）。
PINTEREST_ACCESS_TOKEN=
# 要比對的板子名稱——填 Pinterest 上的「顯示名稱」，不是網址 slug（兩者不一樣，
# 2026-09-19 真實 API 驗證時踩過這個坑：網址是 intentweave-references，
# 但板子的 name 欄位是「IntentWeave References」）。
PINTEREST_BOARD_NAME="IntentWeave References"
# Login (ENGINE01, required -- "必須登入"). GOOGLE_CLIENT_ID comes from a Google
# Cloud OAuth Client ID (Web application type) -- see CLAUDE.md "Google OAuth
# Client ID" for the exact steps to create one. Must match the Client ID the
# frontend initializes Google Identity Services with.
GOOGLE_CLIENT_ID=

# Any random string -- signs our own session tokens after Google login (not a
# Google value). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# true = skip real Google login, /intent and /profile use a fixed local dev
# user instead. Convenient before GOOGLE_CLIENT_ID is set up. NEVER true for
# the actual demo.
DEV_BYPASS_AUTH=false

# Comma-separated origins allowed to call this API from a browser. Must match
# the Google OAuth Client ID's "Authorized JavaScript origins" (see CLAUDE.md
# "Google OAuth Client ID"). Default covers both the old Vite test page
# (scripts/engine01-test-page/, port 5173) and the actual frontend, which
# turned out to be Next.js (port 3000), not the originally planned Vite setup
# -- add the demo deployment's URL here too once there is one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 2026-09-19 新增：POST /recommend 呼叫 ENGINE02 用。本機啟動 ENGINE02：
# ENGINE02_CATALOG=data/catalog/hm_filled ENGINE02_DEMO=1 \
#   ENGINE02_PUBLIC_BASE=http://localhost:8002/engine02 \
#   uvicorn mcp_servers.catalog.main:app --port 8002
# 2026-09-20 補上 ENGINE02_CATALOG：ENGINE02 這支服務完全不讀 .env（沒有
# load_dotenv()），這個變數只能靠啟動指令自己帶，寫在這裡純粹是給人抄的範例，
# 不是真的會被載入。沒帶這個變數會落到 engine02/api.py 的預設值
# data/catalog/kagl（只有 5,000 件、比賽前的舊商品庫）——data/README.md 步驟 5
# 另外準備了 data/catalog/hm_filled（9,870 件，H&M，「demo 建議用這個」），
# 但這件事只寫在 data/README.md 一處，CLAUDE.md／mcp_servers/catalog/README.md
# 原本都只提舊的預設值，容易讓人不小心用舊商品庫跑 demo，這裡一併校正。
# （ENGINE02 負責人交接文件指定的啟動方式；mcp_servers/catalog/ 內容目前跟
# backend/engine02_retrieval/ 逐位元組相同，只是這次遷移之後走新路徑。
# 2026-09-19 修正：原本這裡跟上面 CORS 範例一樣誤植成 8000，跟 ENGINE01 自己的
# port 撞了——前端 NEXT_PUBLIC_API_BASE_URL 預期 ENGINE01 本身在 8000，
# ENGINE02 官方指令是 8002，兩者不能一樣。
# 2026-09-19 再次修正：ENGINE02_PUBLIC_BASE 這個給「ENGINE02 進程自己」用的環境變數
# 一定要帶 /engine02 這段路徑——mcp_servers.catalog.main:app 是把整個 engine02.api
# 用 app.mount("/engine02", ...) 掛上去的，engine02/intent_adapter.py 拿
# ENGINE02_PUBLIC_BASE 直接接 "/images/<id>" 組出回應裡的圖片網址，如果這裡沒帶
# /engine02，組出來的網址會 404（真正能連到的路徑是 /engine02/images/<id>，
# 不是 /images/<id>）——這是 mcp_servers/catalog/README.md 自己範例指令裡的既有
# 坑，不是 ENGINE01 這邊接錯，已經對真實跑起來的服務驗證過這個修法。
# 注意這跟下面 ENGINE02_BASE_URL（ENGINE01 拿去打 ENGINE02 用的）是兩個獨立變數，
# ENGINE02_BASE_URL 本身不用加這段路徑，backend/engine01_intent/engine02_client.py
# 呼叫 /engine02/... 系列端點時已經自己組好前綴。
ENGINE02_BASE_URL=http://localhost:8002

# 2026-09-19 新增：POST /feedback 呼叫 ENGINE03（backend/engine03_feedback/）用。
# 本機啟動 ENGINE03：uvicorn backend.engine03_feedback.main:app --port 8003
# （ENGINE03 吃共用的 backend/requirements.txt，不用像 ENGINE02 另開 venv）。
ENGINE03_BASE_URL=http://localhost:8003

# Virtual You / Create You.
# Start the local extraction service with:
#   uvicorn backend.virtual_you.main:app --host 127.0.0.1 --port 8081
# The Next.js API route defaults to this URL if the variable is omitted.
PERSON_EXTRACTION_SERVICE_URL=http://127.0.0.1:8081/extract
PERSON_EXTRACTION_MODEL=birefnet-portrait

# Optional GPU try-on worker endpoint. Leave blank for a stable mock fallback that
# returns the extracted person image while preserving the frontend loading/swap flow.
VIRTUAL_TRY_ON_PROVIDER=mock
VIRTUAL_TRY_ON_SERVICE_URL=
VIRTUAL_TRY_ON_WORKER_URL=
VIRTUAL_TRY_ON_TIMEOUT_SECONDS=180

# Optional Codex-backed virtual try-on. Requires local `codex login`, but does
# not require OPENAI_API_KEY when using the authenticated Codex CLI workflow.
# Set VIRTUAL_TRY_ON_PROVIDER=codex and point the frontend route at this service:
#   VIRTUAL_TRY_ON_SERVICE_URL=http://127.0.0.1:8081/try-on
CODEX_BIN=codex
CODEX_TRY_ON_TIMEOUT=180
CODEX_TRY_ON_CONCURRENCY=1

# ---------------------------------------------------------------------------
# 以下為 2026-09-19 新增：scripts/dev-up.sh 會讀這支 .env 把四個服務一次叫起來
# （ENGINE01 8000 / ENGINE02 8002 / ENGINE03 8003 / 生圖 BFF 8100）。
#   cp .env.example .env && 填下面兩個路徑 && ./scripts/dev-up.sh
# ---------------------------------------------------------------------------

# 這台機器的 python。repo 裡有 .venv 就可以留空，dev-up.sh 會自己找 .venv/bin/python。
PYTHON=

# ENGINE02 的 catalog 目錄（要含 items.parquet）。這是本機跑
#   python scripts/prepare_catalog.py --source Marqo/KAGL --limit 5000 --out data/catalog/kagl
# 產出來的，被 .gitignore 擋著不進版控，所以每台機器都要自己產一次或指過去。
# 團隊 demo 用 hm_filled（9,870 筆）。items.parquet 與向量索引已經在 repo 裡，
# 但圖片是第三方的、太大不進版控，fresh clone 之後要先抓一次：
#   python scripts/fetch_catalog_images.py --catalog data/catalog/hm_filled --workers 16
# 抓完是 9,870 張 384px JPEG，可以中斷後重跑（已存在的會跳過）。
ENGINE02_CATALOG=data/catalog/hm_filled
# 向量編碼器。marqo-fashionSigLIP 是團隊 demo 用的真實檢索品質，要
#   pip install torch open_clip_torch transformers
# transformers 少不得：open_clip 用 hf-hub: 載這個模型時，tokenizer 走的是
# HuggingFace 那條，沒裝會在建模型時丟 ModuleNotFoundError（踩過）。
# 這三包好幾 GB，而且第一次啟動還會再從 HuggingFace 下載模型權重。
# hash 不需要任何額外套件、啟動一兩秒，但檢索品質明顯較差，只適合純接線測試。
ENGINE02_ENCODER=marqo-fashionSigLIP

# 卡片理由要不要走團隊的 ChatGPT 帳號改寫成具體句子（真實溫度、航班時間、
# 單品自己的屬性）。codex = 開，none = 回模板理由。離線 demo 請明確設 none。
ENGINE02_REWRITER=codex
# 不要繼承外面 shell 的值：模型不支援某個 effort 會直接拒絕，改寫就默默退回
# 模板，看起來像「沒開」而不是「被拒絕」。
ENGINE02_CODEX_EFFORT=low
ENGINE02_CODEX_MODEL=

# 各服務的 port，要改再動。
ENGINE01_PORT=8000
ENGINE02_PORT=8002
ENGINE03_PORT=8003
BFF_PORT=8100
VIRTUAL_YOU_PORT=8081
# 語音輸入（前端 /api/transcribe 轉給它）。要 pip install faster-whisper，
# 第一次呼叫才下載模型；沒裝的話 dev-up.sh 會跳過，打字流程不受影響。
WHISPER_PORT=9000
WEB_PORT=3000

# 陷阱備忘（2026-09-19 踩過，查了很久）：上面的 ENGINE02_BASE_URL 一定要指向
# 跑 mcp_servers.catalog.main:app 的那個 port（預設 8002），**不能**指向直接跑
# engine02.api:app 的實例。ENGINE01 打的是 {ENGINE02_BASE_URL}/engine02/intent/rank，
# 這個 /engine02 前綴來自 mcp_servers.catalog.main 的 app.mount()；直接跑
# engine02.api 的話沒有這層 mount，整串會 404。而 engine02_client.py 對連線錯誤
# 是「吞掉回空值」的防禦寫法，所以症狀不是報錯，是每一區推薦都默默變成空陣列，
# 前端再把它翻譯成「連不到後端」——完全看不出真正的原因。

# ---------------------------------------------------------------------------
# 2026-09-19 新增：「AI 幫我搭」（前端按鈕 → 生圖 BFF POST /outfit-pair →
# agent/scripts/pair_outfit.py → codex exec，從已生成的六件上衣與六件下身裡挑一組）。
# 跟 ENGINE01 一樣吃 codex login 的訂閱額度，不需要 OPENAI_API_KEY；CODEX_BIN／
# CODEX_MODEL／CODEX_REASONING_EFFORT 沿用上面 ENGINE01 那組，設一次兩邊都吃得到。
# 以下都是選填，預設值就能跑。
# ---------------------------------------------------------------------------

# BFF 等 pair_outfit.py 的秒數。BFF 會原封不動當 --timeout 傳給腳本，所以走按鈕時
# 這個值就是 codex exec 的逾時；BFF 外層 subprocess 再多留 10 秒緩衝，讓腳本來得及
# 自己印出退場 JSON。超時不會報錯——腳本退回第一件配第一件、source=fallback、
# HTTP 仍是 200，畫面上會照實標成退場結果，不會冒充成 AI 的判斷。實測模型正常
# 12–14 秒回，60 是「願意等的上限」不是正常耗時；設太低會每次都走退場。
# OUTFIT_PAIR_TIMEOUT=60

# 只有手動從終端機跑 pair_outfit.py 且沒帶 --timeout 時才看這個；透過 BFF 呼叫時
# 一律被上面 OUTFIT_PAIR_TIMEOUT 蓋掉，兩個都設以 OUTFIT_PAIR_TIMEOUT 為準。
# ENGINE01 的 CODEX_TIMEOUT_SECONDS 跟這支無關。
# PAIR_OUTFIT_TIMEOUT=45
