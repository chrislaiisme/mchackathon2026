# Copy this file to .env and fill in real values. Never commit .env.

# ENGINE01 does NOT need this -- it runs on `codex exec` (your ChatGPT Plus/Pro
# subscription via `codex login`, no API key). See CLAUDE.md "ENGINE01 執行方式：
# codex exec". This is still needed by ENGINE02 (recommendation reasons), ENGINE03
# (feedback structuring), and the generation module (image_generation tool), if/when
# the team decides to get a platform.openai.com key -- see CLAUDE.md "P0 現況".
OPENAI_API_KEY=

# Optional: override the default model per module during development.
OPENAI_MODEL=gpt-4o-mini

# Local Whisper speech-to-text. These are the defaults; uncomment to override.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=
# WHISPER_API_URL=http://127.0.0.1:9000/transcribe

# Optional ENGINE01 tuning (defaults are fine) -- see backend/engine01_intent/llm_client.py
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=low
# CODEX_TIMEOUT_SECONDS=90

# Pinterest API v5 (Trial access, team account) — used by backend/pinterest only.
# 2026-09-19 起也被 ENGINE01 的 /intent 用來做單輪參考圖 fallback（使用者沒上傳圖
# 時，比對這個 board 找一張相關圖，只供 ENGINE02 內部參考，不會顯示在畫面上）。
PINTEREST_ACCESS_TOKEN=
# 要比對的板子名稱——填 Pinterest 上的「顯示名稱」，不是網址 slug（兩者不一樣，
# 2026-09-19 真實 API 驗證時踩過這個坑：網址是 intentweave-references，
# 但板子的 name 欄位是「IntentWeave References」）。
PINTEREST_BOARD_NAME=IntentWeave References

# Login (ENGINE01, required -- "必須登入"). GOOGLE_CLIENT_ID comes from a Google
# Cloud OAuth Client ID (Web application type) -- see CLAUDE.md "Google OAuth
# Client ID" for the exact steps to create one. Must match the Client ID the
# frontend initializes Google Identity Services with.
GOOGLE_CLIENT_ID=

# Any random string -- signs our own session tokens after Google login (not a
# Google value). Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# true = skip real Google login, /intent and /profile use a fixed local dev
# user instead. Convenient before GOOGLE_CLIENT_ID is set up. NEVER true for
# the actual demo.
DEV_BYPASS_AUTH=false

# Comma-separated origins allowed to call this API from a browser. Must match
# the Google OAuth Client ID's "Authorized JavaScript origins" (see CLAUDE.md
# "Google OAuth Client ID"). Default covers both the old Vite test page
# (scripts/engine01-test-page/, port 5173) and the actual frontend, which
# turned out to be Next.js (port 3000), not the originally planned Vite setup
# -- add the demo deployment's URL here too once there is one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 2026-09-19 新增：POST /recommend 呼叫 ENGINE02 用。本機啟動 ENGINE02：
# ENGINE02_DEMO=1 ENGINE02_PUBLIC_BASE=http://localhost:8000 \
#   uvicorn mcp_servers.catalog.main:app --port 8000
# （ENGINE02 負責人交接文件指定的方式；mcp_servers/catalog/ 內容目前跟
# backend/engine02_retrieval/ 逐位元組相同，只是這次遷移之後走新路徑。）
ENGINE02_BASE_URL=http://localhost:8000
